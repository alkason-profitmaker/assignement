# PrintHub Community - Development Environment Configuration
# Copy this file to .env.development and fill in your values

# =============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# PAYTM PAYMENT GATEWAY (REQUIRED)
# =============================================================================
# Get these from: https://dashboard.paytm.com/next/apikeys
# For testing, use staging credentials
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE=WEBSTAGING
PAYTM_INDUSTRY_TYPE=Retail
PAYTM_CHANNEL_ID=WAP
# Use staging URL for development: https://securegw-stage.paytm.in
PAYTM_BASE_URL=https://securegw-stage.paytm.in

# =============================================================================
# EPSON CONNECT API (REQUIRED)
# =============================================================================
# Register at: https://www.epsonconnect.com/
# Create an application to get these credentials
EPSON_CLIENT_ID=
EPSON_CLIENT_SECRET=
EPSON_REFRESH_TOKEN=
EPSON_BASE_URL=https://api.epsonconnect.com

# =============================================================================
# APP CONFIGURATION
# =============================================================================
APP_NAME=PrintHub Dev
APP_ENV=development
DEBUG_MODE=true
ENABLE_LOGGING=true
ENABLE_CRASHLYTICS=false
ENABLE_ANALYTICS=false

# API Timeouts (in seconds)
API_TIMEOUT=60
MAX_RETRIES=5
