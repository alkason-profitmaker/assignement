# PrintHub Backend Configuration

# App settings
APP_NAME=PrintHub
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# Database (SQLite for MVP, PostgreSQL for production)
DATABASE_URL=sqlite:///./printhub.db
# DATABASE_URL=postgresql://user:password@localhost/printhub

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# JWT Settings
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay Settings (Get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Pricing (INR)
PRICE_BW_PAGE=3.0
PRICE_COLOR_PAGE=10.0

# Order settings
ORDER_VALIDITY_HOURS=2
MAX_FILE_SIZE_MB=50
MAX_PAGES_PER_ORDER=100

# Printer settings
PRINTER_STATION_ID=STATION_001
PRINTER_IP=192.168.1.100

# Society settings (MVP - single society)
SOCIETY_ID=SOCIETY_001
SOCIETY_NAME=Green Valley Apartments
